// Prisma Schema for SportData Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketEmailJobStatus {
  PENDING
  RUNNING
  SENT
  SKIPPED
  FAILED
}

model TicketEmailJob {
  id            String               @id @default(cuid())
  to            String
  ticketCode    String?
  referenceCode String?
  status        TicketEmailJobStatus @default(PENDING)
  attempts      Int                  @default(0)
  availableAt   DateTime             @default(now())
  lockedAt      DateTime?
  lockToken     String?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
}

enum UserRole {
  ADMIN
  CONTENT         @map("EDITOR")
  GAMES_ADMIN
  READ_ONLY
}

enum FederationType {
  INTERNATIONAL_FEDERATION
  NATIONAL_FEDERATION
  SPORTS_CENTER
  CLUB
  SCHOOL
  ACADEMY
  OTHER
}

enum EventLevel {
  INTERNATIONAL
  NATIONAL
  REGIONAL
  PROVINCIAL
  CENTER_INTERNAL
  OPEN
}

enum CompetitionFormat {
  HEAD_TO_HEAD
  ROUND_ROBIN
  HEAT
  LANE
  MULTI_PARTICIPANT
  RELAY
}

enum EntryType {
  INDIVIDUAL
  TEAM
  RELAY
}

enum EntryStatus {
  REGISTERED
  VERIFIED
  WITHDRAWN
  DISQUALIFIED
}

enum SessionStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum ResultStatus {
  DRAFT
  ENTERED
  REFEREE_CONFIRMED
  APPROVED
  PUBLISHED
  LOCKED
}

enum HeatStatus {
  DRAFT
  SCHEDULED
  RUNNING
  FINISHED
  PUBLISHED
}

enum MatchStatus {
  SCHEDULED
  RUNNING
  FINISHED
  CANCELLED
}

enum WinMethod {
  POINTS
  SUBMISSION
  IPPON
  KNOCKOUT
  DISQUALIFICATION
  WALKOVVER
  DECISION
  TECHNICAL
}

enum MatchType {
  POOL
  ELIMINATION
  FINAL
  SEMIFINAL
  QUARTERFINAL
  ROUND_OF_16
  ROUND_OF_32
  GROUP_STAGE
  HEAT
  QUALIFIER
}

enum Gender {
  MALE
  FEMALE
  MIXED
}

enum JiuJitsuDiscipline {
  NEWAZA
  FIGHTING
  CONTACT
  FULL_CONTACT
  DUO
  SHOW
}

enum UniformType {
  GI
  NO_GI
}

enum BeltLevel {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
  OPEN
}

enum DrawType {
  ROUND_ROBIN_POOL
  MAIN_TREE
  POOL_WINNER_TREE
  REPECHAGE
  REPECHAGE_ROUND_OF_16
  DOUBLE_ELIMINATION
}

enum BracketSide {
  ATHLETE1
  ATHLETE2
}

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

enum AthleteMediaType {
  AVATAR
  CCCD_FRONT
  CCCD_BACK
  PASSPORT
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentOcrStatus {
  NOT_REQUESTED
  PENDING
  COMPLETED
  FAILED
}

enum RegistrationSubmissionType {
  INDIVIDUAL
  GROUP
}

enum SportDataAccountType {
  ATHLETE
  REFEREE
  COACH
  TEAM_LEADER
  MEDICAL_STAFF
}

enum EventParticipationRole {
  ATTENDEE
  REFEREE
  TEAM_LEADER
  COACH
  MEDICAL_STAFF
}

enum AccountVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMode {
  FREE
  MANUAL
  ONLINE
}

enum RegistrationStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
}

enum PaymentProvider {
  MOMO
  VNPAY
  BANK_QR
  VISA
}

enum PaymentTransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

model Country {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  flagUrl     String?
  athletes    Athlete[]
  federations Federation[]
  teams       Team[]
  entries     CompetitionEntry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Federation {
  eventParticipations EventParticipation[]
  id                  String               @id @default(cuid())
  code                String?
  name                String
  type                FederationType       @default(NATIONAL_FEDERATION)
  countryId           String
  country             Country              @relation(fields: [countryId], references: [id])
  athletes            Athlete[]
  organizedEvents     Event[]              @relation("EventOrganizer")
  participatingEvents Event[]              @relation("EventParticipatingFederations")
  publicRegistrations EventRegistration[]
  accounts            ParticipantAccount[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([countryId, code])
  @@index([countryId])
  @@index([type])
}

enum Permission {
  DRAW_PRECONFIGURE
}

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  username                 String?    @unique
  name                     String
  password                 String
  role                     UserRole   @default(CONTENT)
  isActive                 Boolean    @default(true)
  resetPasswordTokenHash   String?    @unique
  resetPasswordExpiresAt   DateTime?
  resetPasswordRequestedAt DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  permissions              Permission[] @default([])
  auditLogs                AuditLog[] @relation("AuditActor")
  cmsNotifications         CmsNotification[]

  @@index([isActive, role])
}

// Runtime feature switches. Environment variables provide the initial/default
// value and keep credentials outside the database; this row stores only the
// operator's on/off choices so changes can take effect without a redeploy.
model IntegrationSetting {
  name      String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id                 String   @id @default("global")
  identityOcrEnabled Boolean?
  paymentsEnabled    Boolean?
  momoEnabled        Boolean?
  vnpayEnabled       Boolean?
  bankQrEnabled      Boolean?
  ticketEmailEnabled Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ParticipantAccount {
  eventParticipations    EventParticipation[]
  id                     String                    @id @default(cuid())
  email                  String                    @unique
  password               String
  displayName            String
  phone                  String?
  gender                 Gender?
  birthDate              DateTime?
  countryId              String?
  weight                 Float?
  height                 Float?
  identityType           String?
  documentHash           String?                   @unique
  documentEncrypted      String?
  accountType            SportDataAccountType      @default(ATHLETE)
  accountTypes           SportDataAccountType[]    @default([ATHLETE])
  verificationStatus     AccountVerificationStatus @default(VERIFIED)
  representativePosition String?
  federationId           String?
  federation             Federation?               @relation(fields: [federationId], references: [id], onDelete: SetNull)
  isActive               Boolean                   @default(true)
  resetPasswordTokenHash String?                   @unique
  resetPasswordExpiresAt DateTime?
  resetPasswordRequestedAt DateTime?
  passwordChangedAt      DateTime?
  athlete                Athlete?
  media                  ParticipantAccountMedia[]
  registrations          EventRegistration[]
  submissions            RegistrationSubmission[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([isActive])
  @@index([accountType, verificationStatus])
  @@index([federationId])
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String    @db.Text
  coverImageUrl String?
  isPublished   Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([isPublished, isFeatured, publishedAt])
  @@index([createdAt])
}

model Banner {
  id            String   @id @default(cuid())
  title         String?
  altText       String
  linkUrl       String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  imageStorageKey     String?
  imageMimeType String
  imageSize     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  adminNote String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

model Sport {
  id                 String                @id @default(cuid())
  name               String
  code               String                @unique
  description        String?
  logoUrl            String?
  logoStorageKey           String?
  logoMimeType       String?
  logoSize           Int?
  displayName        String?
  subtitle           String?
  isVisible          Boolean               @default(true)
  sortOrder          Int                   @default(0)
  backgroundStorageKey     String?
  backgroundMimeType String?
  backgroundSize     Int?
  events             Event[]               @relation("EventSports")
  primaryEvents      Event[]               @relation("PrimarySportEvents")
  categories         Category[]
  statistics         Statistic[]
  venues             Venue[]               @relation("VenueSports")
  teams              Team[]
  sessions           CompetitionSession[]
  scheduleRules      SportSchedulingRule[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([isVisible, sortOrder])
}

model Category {
  scheduleOwners       MatchScheduleCategory[]
  weightKind           String?
  drawPreconfigurations DrawPreconfiguration[]
  id                   String              @id @default(cuid())
  name                 String
  sportId              String
  sport                Sport               @relation(fields: [sportId], references: [id])
  gender               Gender
  discipline           JiuJitsuDiscipline?
  uniform              UniformType?
  beltLevel            BeltLevel?
  matchDurationSeconds Int?
  minAge               Int?
  maxAge               Int?
  minWeight            Float?
  maxWeight            Float?
  athletes             Athlete[]
  matches              Match[]
  divisions            Division[]
  draws                Draw[]
  events               Event[]
  format               CompetitionFormat   @default(HEAD_TO_HEAD)
  laneCount            Int?
  maxEntriesPerCountry Int?
  entries              CompetitionEntry[]
  heats                Heat[]
  roundRobinGroups     RoundRobinGroup[]
  publicRegistrations  EventRegistration[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([sportId])
}

model Division {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  matches    Match[]
  draws      Draw[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

enum EventAgeLimitMode {
  CATEGORY
  UNRESTRICTED
  CUSTOM
}

model Event {
  schedulePlans MatchSchedulePlan[]
  eventParticipations EventParticipation[]
  drawPreconfigurations DrawPreconfiguration[]
  id                       String                   @id @default(cuid())
  name                     String
  sportId                  String
  sport                    Sport                    @relation("PrimarySportEvents", fields: [sportId], references: [id])
  sports                   Sport[]                  @relation("EventSports")
  description              String?
  startDate                DateTime
  endDate                  DateTime
  location                 String?
  bannerUrl                String?
  logoUrl                  String?
  bannerStorageKey               String?
  bannerMimeType           String?
  bannerSize               Int?
  logoStorageKey                 String?
  logoMimeType             String?
  logoSize                 Int?
  ticketBackgroundStorageKey     String?
  ticketBackgroundMimeType String?
  ticketBackgroundSize     Int?
  ticketDesign             Json?
  ticketThemePreset        String                   @default("OCEAN")
  ticketLayout             String                   @default("CLASSIC")
  ticketPrimaryColor       String                   @default("#0284C7")
  ticketSecondaryColor     String                   @default("#075985")
  ticketAccentColor        String                   @default("#059669")
  matches                  Match[]
  draws                    Draw[]
  fops                     Fop[]
  athletes                 Athlete[]
  categories               Category[]
  level                    EventLevel               @default(INTERNATIONAL)
  organizerId              String?
  organizer                Federation?              @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  participatingFederations Federation[]             @relation("EventParticipatingFederations")
  allowIndependentAthletes Boolean                  @default(true)
  ageLimitMode             EventAgeLimitMode        @default(UNRESTRICTED)
  minAge                   Int?
  maxAge                   Int?
  registrationEnabled      Boolean                  @default(false)
  registrationOpenAt       DateTime?
  registrationCloseAt      DateTime?
  registrationFee          Int                      @default(0)
  registrationCurrency     String                   @default("VND")
  paymentMode              PaymentMode              @default(FREE)
  paymentProviders         PaymentProvider[]        @default([])
  bankCode                 String?
  bankAccountNumber        String?
  bankAccountName          String?
  registrations            EventRegistration[]
  cmsNotifications         CmsNotification[]
  registrationSubmissions  RegistrationSubmission[]
  statistics               Statistic[]
  venues                   Venue[]                  @relation("EventVenues")
  sessions                 CompetitionSession[]
  entries                  CompetitionEntry[]
  teams                    Team[]
  scheduleRules            SportSchedulingRule[]
  heats                    Heat[]
  roundRobinGroups         RoundRobinGroup[]
  isPublished              Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([sportId])
  @@index([startDate])
  @@index([level])
  @@index([organizerId])
}

model Athlete {
  identity             AthleteIdentity?
  id                   String              @id @default(cuid())
  firstName            String
  lastName             String
  fullName             String
  email                String?
  phone                String?
  gender               Gender
  birthDate            DateTime?
  weight               Float?
  height               Float?
  countryId            String
  country              Country             @relation(fields: [countryId], references: [id])
  federationId         String?
  federation           Federation?         @relation(fields: [federationId], references: [id])
  photoUrl             String?
  participantAccountId String?             @unique
  participantAccount   ParticipantAccount? @relation(fields: [participantAccountId], references: [id], onDelete: SetNull)
  media                AthleteMedia[]
  publicRegistrations  EventRegistration[]
  matchesAsAthlete1    Match[]             @relation("Athlete1Matches")
  matchesAsAthlete2    Match[]             @relation("Athlete2Matches")
  matchesAsWinner      Match[]             @relation("WinnerMatches")
  events               Event[]
  categories           Category[]
  statistics           Statistic[]
  teamMemberships      TeamMember[]
  entries              CompetitionEntry[]
  matchParticipants    MatchParticipant[]
  heatLanes            HeatLane[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([countryId])
  @@index([federationId])
  @@index([fullName])
  @@index([birthDate])
  @@index([email])
}

model AthleteIdentity {
  athleteId    String   @id
  athlete      Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  documentHash String?
  cccdHash     String?
  passportHash String?
  cccdEncrypted String?
  passportEncrypted String?
  addressHash  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([documentHash])
  @@index([cccdHash])
  @@index([passportHash])
}

model AthleteMedia {
  id                 String                      @id @default(cuid())
  athleteId          String
  athlete            Athlete                     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  type               AthleteMediaType
  storageKey               String?
  mimeType           String
  size               Int
  verificationStatus DocumentVerificationStatus?
  verificationNote   String?
  verifiedAt         DateTime?
  verifiedBy         String?
  ocrStatus          DocumentOcrStatus           @default(NOT_REQUESTED)
  ocrProvider        String?
  ocrConfidence      Float?
  ocrData            Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([athleteId, type])
  @@index([athleteId])
}

model ParticipantMediaUpload {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  type      AthleteMediaType
  storageKey      String?
  mimeType  String
  size      Int
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([expiresAt])
}

model ParticipantAccountMedia {
  id                 String                      @id @default(cuid())
  accountId          String
  account            ParticipantAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type               AthleteMediaType
  storageKey         String?
  mimeType           String
  size               Int
  verificationStatus DocumentVerificationStatus?
  verificationNote   String?
  verifiedAt         DateTime?
  verifiedBy         String?
  ocrStatus          DocumentOcrStatus             @default(NOT_REQUESTED)
  ocrProvider        String?
  ocrConfidence      Float?
  ocrData            Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([accountId, type])
}

model RegistrationSubmission {
  id               String                     @id @default(cuid())
  eventId          String
  event            Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId        String?
  account          ParticipantAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type             RegistrationSubmissionType @default(INDIVIDUAL)
  contactName      String
  contactEmail     String
  contactPhone     String?
  organizationName String?
  referenceCode    String                     @unique
  registrations    EventRegistration[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([eventId, createdAt])
  @@index([contactEmail, createdAt])
  @@index([accountId])
}

model EventParticipation {
  id            String                 @id @default(cuid())
  eventId       String
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId     String?
  account       ParticipantAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  role          EventParticipationRole
  contactName   String
  contactEmail  String
  contactPhone  String?
  identityType  String?
  documentEncrypted String?
  media         EventParticipationMedia[]
  federationId  String?
  federation    Federation?            @relation(fields: [federationId], references: [id], onDelete: Restrict)
  referenceCode String                 @unique
  status        RegistrationStatus     @default(SUBMITTED)
  statusReason  String?
  statusChangedAt DateTime?
  statusChangedBy String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([eventId, contactEmail, role])
  @@index([accountId, createdAt])
  @@index([eventId, role, status])
}

model EventParticipationMedia {
  id              String              @id @default(cuid())
  participationId String
  participation   EventParticipation  @relation(fields: [participationId], references: [id], onDelete: Cascade)
  type            AthleteMediaType
  storageKey      String
  mimeType        String
  size            Int
  verificationStatus DocumentVerificationStatus?
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime            @default(now())

  @@unique([participationId, type])
}

model EventRegistration {
  id                     String                      @id @default(cuid())
  eventId                String
  event                  Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athleteId              String
  athlete                Athlete                     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  accountId              String?
  account                ParticipantAccount?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  submissionId           String?
  submission             RegistrationSubmission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  categoryId             String
  category               Category                    @relation(fields: [categoryId], references: [id])
  federationId           String?
  federation             Federation?                 @relation(fields: [federationId], references: [id], onDelete: SetNull)
  status                 RegistrationStatus          @default(SUBMITTED)
  statusReason           String?
  statusChangedAt        DateTime?
  statusChangedBy        String?
  paymentStatus          PaymentStatus               @default(NOT_REQUIRED)
  paymentStatusReason    String?
  paymentStatusChangedAt DateTime?
  paymentStatusChangedBy String?
  feeAmount              Int                         @default(0)
  currency               String                      @default("VND")
  ticketCode             String                      @unique
  paymentTransactions    PaymentTransaction[]
  statusHistory          RegistrationStatusHistory[]
  paymentStatusHistory   PaymentStatusHistory[]
  cmsNotifications       CmsNotification[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@unique([eventId, athleteId, categoryId])
  @@index([accountId, createdAt])
  @@index([submissionId])
  @@index([eventId, status])
  @@index([categoryId])
  @@index([paymentStatus, createdAt])
}

model CmsNotification {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String?
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  type           String
  title          String
  message        String
  href           String?
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@index([userId, readAt, createdAt])
  @@index([eventId, createdAt])
  @@index([registrationId])
}

model RegistrationStatusHistory {
  id             String             @id @default(cuid())
  registrationId String
  registration   EventRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus     RegistrationStatus
  toStatus       RegistrationStatus
  reason         String
  changedBy      String?
  createdAt      DateTime           @default(now())

  @@index([registrationId, createdAt])
}

model PaymentStatusHistory {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus     PaymentStatus
  toStatus       PaymentStatus
  reason         String
  changedBy      String?
  createdAt      DateTime          @default(now())

  @@index([registrationId, createdAt])
}

model PaymentTransaction {
  id                    String                   @id @default(cuid())
  registrationId        String
  registration          EventRegistration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  orderId               String                   @unique
  amount                Int
  currency              String                   @default("VND")
  status                PaymentTransactionStatus @default(PENDING)
  providerTransactionId String?
  checkoutUrl           String?
  qrCodeUrl             String?
  requestPayload        Json?
  responsePayload       Json?
  failureReason         String?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([registrationId, createdAt])
  @@index([provider, status])
}

model Match {
  schedulePlanId     String?
  schedulePlan       MatchSchedulePlan? @relation(fields: [schedulePlanId], references: [id], onDelete: Restrict)
  scheduleRevisionId String?
  scheduleSequence   Int?
  scheduleWindowId   String?
  scheduleItems      MatchScheduleItem[]
  id                 String              @id @default(cuid())
  eventId            String
  event              Event               @relation(fields: [eventId], references: [id])
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  divisionId         String?
  division           Division?           @relation(fields: [divisionId], references: [id])
  drawId             String?
  draw               Draw?               @relation(fields: [drawId], references: [id], onDelete: SetNull)
  matchNumber        Int?
  fop                String?
  fopId              String?
  fopRecord          Fop?                @relation(fields: [fopId], references: [id], onDelete: SetNull)
  matchDate          DateTime
  startTime          DateTime?
  endTime            DateTime?
  athlete1Id         String?
  athlete1           Athlete?            @relation("Athlete1Matches", fields: [athlete1Id], references: [id])
  athlete2Id         String?
  athlete2           Athlete?            @relation("Athlete2Matches", fields: [athlete2Id], references: [id])
  team1Id            String?
  team1              Team?               @relation("Team1Matches", fields: [team1Id], references: [id])
  team2Id            String?
  team2              Team?               @relation("Team2Matches", fields: [team2Id], references: [id])
  athlete1Score      Float               @default(0)
  athlete2Score      Float               @default(0)
  athlete1Advantages Int                 @default(0)
  athlete2Advantages Int                 @default(0)
  athlete1Penalties  Int                 @default(0)
  athlete2Penalties  Int                 @default(0)
  status             MatchStatus         @default(SCHEDULED)
  matchType          MatchType           @default(ELIMINATION)
  winnerId           String?
  winner             Athlete?            @relation("WinnerMatches", fields: [winnerId], references: [id])
  winnerTeamId       String?
  winnerTeam         Team?               @relation("TeamWinnerMatches", fields: [winnerTeamId], references: [id])
  winMethod          WinMethod?
  round              Int?
  bracketPosition    Int?
  winnerToMatchId    String?
  winnerToMatch      Match?              @relation("WinnerProgression", fields: [winnerToMatchId], references: [id], onDelete: SetNull)
  winnerFromMatches  Match[]             @relation("WinnerProgression")
  winnerToSide       BracketSide?
  loserToMatchId     String?
  loserToMatch       Match?              @relation("LoserProgression", fields: [loserToMatchId], references: [id], onDelete: SetNull)
  loserFromMatches   Match[]             @relation("LoserProgression")
  loserToSide        BracketSide?
  pool               String?
  notes              String?
  sessionId          String?
  session            CompetitionSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  timeSlotId         String?             @unique
  timeSlot           TimeSlot?           @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  scheduleLocked     Boolean             @default(false)
  scheduleLockedAt   DateTime?
  scheduleLockedBy   String?
  scheduleLockReason String?
  resultStatus       ResultStatus        @default(DRAFT)
  resultData         Json?
  resultVersion      Int                 @default(0)
  resultEnteredAt    DateTime?
  resultEnteredBy    String?
  refereeConfirmedAt DateTime?
  refereeConfirmedBy String?
  approvedAt         DateTime?
  approvedBy         String?
  resultPublishedAt  DateTime?
  resultPublishedBy  String?
  resultLockedAt     DateTime?
  resultLockedBy     String?
  participants       MatchParticipant[]
  resultRevisions    ResultRevision[]
  roundRobinGroupId  String?
  roundRobinGroup    RoundRobinGroup?    @relation(fields: [roundRobinGroupId], references: [id], onDelete: SetNull)
  heat               Heat?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([eventId])
  @@index([eventId, matchDate])
  @@index([eventId, status])
  @@index([categoryId])
  @@index([drawId])
  @@index([fopId])
  @@index([fopId, startTime])
  @@index([winnerToMatchId])
  @@index([loserToMatchId])
  @@index([matchDate])
  @@index([status])
  @@index([athlete1Id])
  @@index([athlete2Id])
  @@index([team1Id])
  @@index([team2Id])
  @@index([winnerTeamId])
  @@index([sessionId, startTime])
  @@index([resultStatus])
  @@index([roundRobinGroupId])
}

model MatchSchedulePlan {
  id                String @id @default(cuid())
  eventId           String
  event             Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  name              String
  timezone          String @default("Asia/Ho_Chi_Minh")
  draftVersion      Int @default(0)
  appliedRevisionId String?
  createKey         String
  createdBy         String
  updatedBy         String
  draft             Json
  revisions         MatchScheduleRevision[]
  matches           Match[]
  categories        MatchScheduleCategory[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([eventId, createKey])
  @@index([eventId])
}

model MatchScheduleRevision {
  id            String @id @default(cuid())
  planId        String
  plan          MatchSchedulePlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  draftVersion  Int
  inputHash     String
  config        Json
  proposal      Json
  appliedAt     DateTime?
  appliedBy     String?
  applyKey      String? @unique
  applyHash     String?
  createdBy     String
  createdAt     DateTime @default(now())
  items         MatchScheduleItem[]

  @@index([planId, createdAt])
}

model MatchScheduleItem {
  id                 String @id @default(cuid())
  revisionId         String
  revision           MatchScheduleRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  matchId            String
  match              Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  chainSequence      Int
  windowId           String
  localDate          String
  fopId              String
  blockId            String
  stageKey           String
  startTime          DateTime
  endTime            DateTime
  turnaroundSeconds  Int

  @@unique([revisionId, matchId])
  @@unique([revisionId, chainSequence])
  @@index([matchId])
}

model MatchScheduleCategory {
  id         String @id @default(cuid())
  eventId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  planId     String
  plan       MatchSchedulePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([eventId, categoryId])
  @@index([planId])
}

model Draw {
  id          String    @id @default(cuid())
  name        String
  type        DrawType
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  poolNumber  Int?
  bracketSize Int?
  sortOrder   Int       @default(0)
  fops        Fop[]     @relation("DrawFops")
  matches     Match[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([eventId, categoryId, name])
  @@index([eventId, categoryId])
  @@index([divisionId])
}

model Fop {
  id        String     @id @default(cuid())
  name      String
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  draws     Draw[]     @relation("DrawFops")
  matches   Match[]
  venueId   String?
  venue     Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  timeSlots TimeSlot[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([eventId, name])
  @@index([eventId])
  @@index([venueId])
}

model Venue {
  id        String               @id @default(cuid())
  code      String               @unique
  name      String
  location  String?
  capacity  Int?
  timezone  String               @default("Asia/Ho_Chi_Minh")
  isActive  Boolean              @default(true)
  sports    Sport[]              @relation("VenueSports")
  events    Event[]              @relation("EventVenues")
  fops      Fop[]
  sessions  CompetitionSession[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([isActive])
}

model CompetitionSession {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue         @relation(fields: [venueId], references: [id])
  sportId   String?
  sport     Sport?        @relation(fields: [sportId], references: [id], onDelete: SetNull)
  name      String
  startTime DateTime
  endTime   DateTime
  status    SessionStatus @default(DRAFT)
  notes     String?
  timeSlots TimeSlot[]
  matches   Match[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([eventId, startTime])
  @@index([venueId, startTime])
  @@index([sportId, startTime])
}

model TimeSlot {
  id         String             @id @default(cuid())
  sessionId  String
  session    CompetitionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fopId      String
  fop        Fop                @relation(fields: [fopId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  isLocked   Boolean            @default(false)
  lockReason String?
  match      Match?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([sessionId, startTime])
  @@index([fopId, startTime])
}

model SportSchedulingRule {
  id                   String   @id @default(cuid())
  eventId              String
  event                Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sportId              String
  sport                Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  matchDurationMinutes Int      @default(10)
  turnaroundMinutes    Int      @default(5)
  minRestMinutes       Int      @default(60)
  earliestStart        String   @default("08:00")
  latestEnd            String   @default("22:00")
  preferredStart       String?
  preferredEnd         String?
  outdoor              Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([eventId, sportId])
  @@index([sportId])
}

model Team {
  id                String             @id @default(cuid())
  eventId           String
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sportId           String
  sport             Sport              @relation(fields: [sportId], references: [id])
  countryId         String
  country           Country            @relation(fields: [countryId], references: [id])
  name              String
  code              String?
  gender            Gender?
  members           TeamMember[]
  entries           CompetitionEntry[]
  matchesAsTeam1    Match[]            @relation("Team1Matches")
  matchesAsTeam2    Match[]            @relation("Team2Matches")
  matchesAsWinner   Match[]            @relation("TeamWinnerMatches")
  matchParticipants MatchParticipant[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([eventId, sportId, countryId, name])
  @@index([eventId, sportId])
  @@index([countryId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  role      String?
  relayLeg  Int?
  isReserve Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([teamId, athleteId])
  @@index([athleteId])
}

model CompetitionEntry {
  id                String                  @id @default(cuid())
  eventId           String
  event             Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  countryId         String
  country           Country                 @relation(fields: [countryId], references: [id])
  type              EntryType
  status            EntryStatus             @default(REGISTERED)
  athleteId         String?
  athlete           Athlete?                @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  teamId            String?
  team              Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  seed              Int?
  bib               String?
  notes             String?
  matchParticipants MatchParticipant[]
  heatLanes         HeatLane[]
  roundRobinGroups  RoundRobinGroupMember[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([eventId, categoryId, athleteId])
  @@unique([eventId, categoryId, teamId])
  @@index([eventId, categoryId, status])
  @@index([countryId])
}

model MatchParticipant {
  id        String            @id @default(cuid())
  matchId   String
  match     Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  entryId   String?
  entry     CompetitionEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  athleteId String?
  athlete   Athlete?          @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  teamId    String?
  team      Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  lane      Int?
  position  Int?
  score     Json?
  rank      Int?
  qualified Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([matchId, entryId])
  @@index([athleteId])
  @@index([teamId])
}

model Heat {
  id         String     @id @default(cuid())
  eventId    String
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  round      Int        @default(1)
  sequence   Int        @default(1)
  status     HeatStatus @default(DRAFT)
  startTime  DateTime?
  matchId    String?    @unique
  match      Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  lanes      HeatLane[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([eventId, categoryId, round, sequence])
  @@index([eventId, startTime])
}

model HeatLane {
  id        String           @id @default(cuid())
  heatId    String
  heat      Heat             @relation(fields: [heatId], references: [id], onDelete: Cascade)
  entryId   String
  entry     CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  athleteId String?
  athlete   Athlete?         @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  lane      Int
  result    Json?
  rank      Int?
  qualified Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([heatId, lane])
  @@unique([heatId, entryId])
}

model RoundRobinGroup {
  id         String                  @id @default(cuid())
  eventId    String
  event      Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  members    RoundRobinGroupMember[]
  matches    Match[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([eventId, categoryId, name])
  @@index([eventId, categoryId])
}

model RoundRobinGroupMember {
  id        String           @id @default(cuid())
  groupId   String
  group     RoundRobinGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryId   String
  entry     CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  seed      Int?
  createdAt DateTime         @default(now())

  @@unique([groupId, entryId])
}

model ResultRevision {
  id          String       @id @default(cuid())
  matchId     String
  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  version     Int
  status      ResultStatus
  action      String
  before      Json?
  after       Json?
  reason      String?
  actorUserId String?
  createdAt   DateTime     @default(now())

  @@unique([matchId, version])
  @@index([matchId, createdAt])
  @@index([actorUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  method      String?
  path        String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model Statistic {
  id           String   @id @default(cuid())
  athleteId    String
  athlete      Athlete  @relation(fields: [athleteId], references: [id])
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])
  sportId      String
  sport        Sport    @relation(fields: [sportId], references: [id])
  categoryId   String?
  totalWins    Int      @default(0)
  totalLosses  Int      @default(0)
  totalDraws   Int      @default(0)
  totalMatches Int      @default(0)
  goldMedals   Int      @default(0)
  silverMedals Int      @default(0)
  bronzeMedals Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([athleteId, eventId, sportId])
  @@index([athleteId])
  @@index([eventId])
  @@index([sportId])
}

// Private draw data is exposed only through permission-checked endpoints.
model DrawPreconfiguration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  drawType     DrawType
  pairs        Json
  options      Json
  revision     Int      @default(1)
  inputVersion String?
  slots        Json?
  plan         Json?
  previewedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  history      DrawPreconfigurationHistory[]

  @@unique([eventId, categoryId, drawType])
}

model DrawPreconfigurationHistory {
  id              String   @id @default(cuid())
  configurationId String
  configuration   DrawPreconfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  actorUserId     String
  action          String
  revision        Int
  snapshot        Json
  createdAt       DateTime @default(now())

  @@index([configurationId, createdAt])
}

// Temporary chunk storage used to keep each Vercel upload request below the
// platform payload limit. These tables are excluded from exported backups.
model BackupUpload {
  id           String              @id
  fileName     String
  totalSize    BigInt
  receivedSize BigInt              @default(0)
  nextChunk    Int                 @default(0)
  status       String              @default("UPLOADING")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now())
  expiresAt    DateTime
  chunks       BackupUploadChunk[]

  @@index([expiresAt])
}

model BackupUploadChunk {
  uploadId  String
  index     Int
  size      Int
  sha256    String
  storageKey      String?
  createdAt DateTime     @default(now())
  upload    BackupUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, index])
}
